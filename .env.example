# ============================================
# MyJudicial — Single Production .env
# ============================================
# Copy this file to .env and fill in the values.
#
# This ONE file configures the entire Docker stack (docker-compose.yml):
#   - Top-level vars are used by compose for interpolation and passed as
#     build args to the frontend image (NEXT_PUBLIC_* are inlined at build).
#   - The backend and AI containers receive their vars from this same file
#     via explicit `environment:` mappings in docker-compose.yml.
#
# The per-service .env.example files (myjudicial-*/) still exist for
# LOCAL development only — they are NOT read by docker compose anymore.
#
# NOTE: If any secret value contains a literal `$`, write it as `$$`
# (compose interpolation). Do not wrap values in quotes.
# ============================================

# ============================================
# --- Domain & URLs ---
# ============================================
# PUBLIC URLs — used by the frontend build (NEXT_PUBLIC_*), backend
# CORS, redirects, email links, and webhook callbacks.
# These must be the real HTTPS domains served by Caddy.
FRONTEND_URL=https://myjudicial.com
BACKEND_URL=https://api.myjudicial.com

# -----------------------------------------------
# CADDY REVERSE PROXY (production HTTPS)
# -----------------------------------------------
# Caddy is the only service exposed publicly (ports 80/443).
# It reverse-proxies:
#   https://myjudicial.com       -> frontend:3000
#   https://api.myjudicial.com   -> backend:4000
# The AI service (port 5000) is NEVER exposed publicly.
#
# Cloudflare DNS (DNS-only / gray cloud):
#   A  @     <VPS_PUBLIC_IP>
#   A  api   <VPS_PUBLIC_IP>
# Set Cloudflare SSL/TLS → Full (not Strict) so Caddy's
# Let's Encrypt certificate is used end-to-end.
# -----------------------------------------------

# Internal Docker service URLs (do NOT change — used between containers)
AI_SERVICE_URL=http://ai:5000

# --- Auth ---
# NextAuth/secret used by the frontend. Generate: openssl rand -hex 32
AUTH_SECRET=your-nextauth-secret-here

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Optional: webhook secret for Supabase Auth events (openssl rand -hex 32)
SUPABASE_WEBHOOK_SECRET=

# --- Database (Supabase PostgreSQL) ---
# Transaction pooler — used by the running app (port 6543)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection — used for migrations only (port 5432)
DIRECT_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# --- Redis ---
# Free tier: https://upstash.com → Create Redis DB → copy rediss:// URL
REDIS_URL=rediss://default:[password]@[host].upstash.io:6379

# --- LiveKit (Video consultations) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_HOST=https://your-project.livekit.cloud

# =============================================
# BACKEND (Express API — container: myjudicial-backend)
# =============================================
NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# Comma-separated allowed origins (defaults to FRONTEND_URL)
CORS_ORIGIN=https://myjudicial.com

# Public base URL of the API (used to build AzamPay redirect/callback URLs)
BASE_URL=https://api.myjudicial.com

# Platform commission rate (0.15 = 15%)
PLATFORM_COMMISSION=0.15

# Internal AI service URL (Docker network name — do not change)
# AI is NOT publicly exposed; only the backend reaches it via this internal URL.
AI_SERVICE_URL=http://ai:5000
# Shared secret between backend and AI service (must equal AI API_KEY below)
AI_SERVICE_KEY=dev-secret-key-12323456

# Optional rate-limit tuning (current limiter does not read these yet)
# AUTH_OTP_SEND_EMAIL_MAX=5
# AUTH_OTP_SEND_IP_MAX=10
# AUTH_OTP_VERIFY_MAX=5
# AUTH_LOGIN_MAX=5
# AUTH_PUBLIC_MAX=10

# --- Email (Brevo) ---
# API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-...
EMAIL_FROM_NAME=MyJudicial
EMAIL_FROM_ADDRESS=no-reply@myjudicial.com
# Inbox that receives user replies to transactional emails (must be a real mailbox).
EMAIL_REPLY_TO=support@myjudicial.com
# Real logo used in email header. Defaults to ${FRONTEND_URL}/myjudicial-logo-white.png
EMAIL_LOGO_URL=https://myjudicial.com/myjudicial-logo-white.png

# --- Payments (AzamPay — mobile money / escrow) ---
# "sandbox" or "production". IMPORTANT: sandbox and production credentials are
# issued separately — using the wrong ENV for a credential set is rejected by
# AzamPay. Set production only once you have PRODUCTION credentials.
AZAMPAY_ENV=sandbox   # "sandbox" or "production"
AZAMPAY_APP_NAME=myjudicial
AZAMPAY_CLIENT_ID=your-client-id
AZAMPAY_CLIENT_SECRET=your-client-secret
AZAMPAY_API_KEY=your-x-api-key
# Shared secret used to verify x-azampay-signature on payment webhooks
AZAMPAY_WEBHOOK_SECRET=your-webhook-secret
# Payouts/refunds (escrow) — set true only with production payout credentials
AZAMPAY_DISBURSEMENT_ENABLED=false
AZAMPAY_SOURCE_COUNTRY_CODE=RW
AZAMPAY_SOURCE_FULL_NAME=MyJudicial Platform
AZAMPAY_SOURCE_BANK_NAME=Platform Wallet
AZAMPAY_SOURCE_ACCOUNT_NUMBER=
AZAMPAY_DEST_COUNTRY_CODE=RW

# --- OCI Object Storage (S3-compatible) ---
# Endpoint: https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
OCI_ENDPOINT=https://[namespace].compat.objectstorage.[region].oraclecloud.com
OCI_BUCKET_NAME=myjudicial-vault
OCI_REGION=us-ashburn-1
OCI_ACCESS_KEY_ID=your-customer-secret-key-access-key
OCI_SECRET_ACCESS_KEY=your-customer-secret-key
OCI_KMS_ENDPOINT=   # e.g., https://[id]-crypto.kms.[region].oci.oraclecloud.com
OCI_KMS_MASTER_KEY_ID=   # OCID of the Master Encryption Key in Vault
# Signed URL TTL in seconds — default 900 (15 min), max recommended 3600
OCI_SIGNED_URL_EXPIRY_SECONDS=900

# --- Admin seed (only used by npm run db:seed) ---
ADMIN_EMAIL=admin@myjudicial.com
ADMIN_FULL_NAME=MyJudicial Admin
ADMIN_PASSWORD=strong-password-min-8-chars

# =============================================
# AI SERVICE (FastAPI — container: myjudicial-ai)
# =============================================
APP_NAME=MyJudicial AI Triage Service
DEBUG=false
# Must equal AI_SERVICE_KEY above
API_KEY=dev-secret-key-12323456
HOST=0.0.0.0
PORT=5000

# LLM: "groq" (cloud, default in Docker) or "ollama" (local/VPS)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...   # required when LLM_PROVIDER=groq — https://console.groq.com
GROQ_MODEL=llama-3.1-8b-instant

# Ollama (only used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest
OLLAMA_TIMEOUT=60

# Whisper (transcription)
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu

# Embeddings & vector search (pgvector)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
VECTOR_SEARCH_LIMIT=50
SIMILARITY_THRESHOLD=0.5

# Recommendation ranking weights
SCORE_WEIGHT_SIMILARITY=0.40
SCORE_WEIGHT_RATING=0.25
SCORE_WEIGHT_BUDGET=0.15
SCORE_WEIGHT_REVIEWS=0.10
SCORE_WEIGHT_EXPERIENCE=0.05
SCORE_WEIGHT_SPECIALTY=0.05
RECOMMENDATION_LIMIT=10
MIN_RECOMMENDATION_SCORE=0.3
EXPLANATION_LEVEL=detailed

# Caching
CACHE_EMBEDDINGS=true
CACHE_SIZE=1000

# =============================================
# FRONTEND (local `next dev` only)
# Docker compose DERIVES these from the values above
# (FRONTEND_URL, BACKEND_URL, SUPABASE_URL, SUPABASE_ANON_KEY, LIVEKIT_URL)
# =============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_PREFIX=/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
AUTH_URL=http://localhost:3000
RATE_LIMIT_ENABLED=true

# --- SMS / Email (frontend, optional / future) ---
SMS_PROVIDER=console
SMS_FROM=MyJudicial
EMAIL_PROVIDER=console   # console | ses
EMAIL_FROM=MyJudicial <no-reply@myjudicial.com>
EMAIL_REPLY_TO=support@myjudicial.com
AWS_REGION=replace-me
AWS_SES_REGION=
AWS_SES_CONFIGURATION_SET=
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
