# ============================================
# MyJudicial Docker Deployment - Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# The backend and AI service also need their own .env files
# in their respective directories.
# ============================================

# --- Domain & URLs (update for your VPS) ---
FRONTEND_URL=http://your-domain.com
BACKEND_URL=http://your-domain.com

# --- Auth ---
AUTH_SECRET=your-nextauth-secret-here

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Database (only needed if overriding AI service DB) ---
DATABASE_URL=postgresql://...

# --- LiveKit ---
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
