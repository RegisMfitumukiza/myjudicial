# ============================================
# MyJudicial — LOCAL DEV env template
# ============================================
# cp .env.local.example .env.local   then fill values
#
# .env.local is git-ignored. Use it with:
#   docker compose --env-file .env.local up -d --build
# (or just keep root .env as-is — docker-compose.override.yml already
#  forces localhost URLs for local runs.)
#
# Goal: local runs must NEVER touch production Supabase. Create a free
# second Supabase project, run `npx prisma migrate deploy` against it,
# and paste its URLs/keys below.
# ============================================

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
BASE_URL=http://localhost:4000

# --- Local/dev database (REQUIRED to avoid prod data) ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/myjudicial_dev
DIRECT_URL=postgresql://postgres:password@localhost:5432/myjudicial_dev

# --- Everything else: copy from root .env ---
