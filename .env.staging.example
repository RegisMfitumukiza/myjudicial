# ============================================
# MyJudicial — STAGING environment
# ============================================
# NOT a standalone file: start from the production .env and apply the
# overrides below. Every staging deploy must be able to break without
# touching production data or users.
#
# Bootstrap (on the VPS):
#   git clone <repo> ~/myjudicial-staging
#   cd ~/myjudicial-staging
#   cp ~/myjudicial/.env .env          # then apply this checklist
#   nano .env
# ============================================
#
# --- MUST differ from production ------------------------------
# FRONTEND_URL=https://staging.myjudicial.com
# BACKEND_URL=https://api.staging.myjudicial.com
# BASE_URL=https://api.staging.myjudicial.com
# CORS_ORIGIN=https://staging.myjudicial.com,http://localhost:3000
# AUTH_SECRET=<new value: openssl rand -hex 32>
# DATABASE_URL=<STAGING Supabase project pooler URL>
# DIRECT_URL=<STAGING Supabase project direct URL>
# SUPABASE_URL=<staging project URL>
# SUPABASE_ANON_KEY=<staging anon key>
# SUPABASE_SERVICE_ROLE_KEY=<staging service role key>
# AI_SERVICE_KEY=<new value: openssl rand -hex 32>
# ADMIN_EMAIL / ADMIN_PASSWORD=<staging-only admin>
#
# --- Safe to reuse from production (external sandboxes) --------
# GROQ_API_KEY, BREVO_API_KEY (use a test list), AZAMPAY_* (sandbox),
# LIVEKIT_*, OCI_* (or a separate myjudicial-staging bucket)
#
# --- Image tags (managed by CI; pull-based deploys) -------------
# FRONTEND_TAG=latest
# BACKEND_TAG=latest
# AI_TAG=latest
