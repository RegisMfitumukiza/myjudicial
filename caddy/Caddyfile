# ============================================
# MyJudicial Caddyfile
# Reverse Proxy with Automatic HTTPS
# ============================================
# Caddy automatically obtains and renews TLS certificates
# from Let's Encrypt. No manual certificate configuration needed.
#
# Cloudflare DNS: Point A @ and A api records to this VPS IP
# (DNS-only / gray cloud) so Caddy can complete HTTP-01 challenges.
# ============================================

# Main frontend
myjudicial.com {
	# Reverse proxy to Next.js frontend
	reverse_proxy frontend:3000

	# Use internal CA (Caddy-managed self-signed).
	# For real Let's Encrypt certificates, set Cloudflare DNS records
	# for @ and api to DNS-only (gray cloud) so HTTP-01 challenge can reach Caddy.
	# Then remove the `tls internal` line below.
	tls internal

	# Compression
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	log {
		output stdout
		format json
	}
}

# Backend API
api.myjudicial.com {
	reverse_proxy backend:4000
	tls internal
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	log {
		output stdout
		format json
	}
}
