# Application
APP_NAME="MyJudicial AI Triage Service"
DEBUG=false

# API Security
API_KEY=your-secret-api-key-change-in-production

# Server
HOST=0.0.0.0
PORT=5000

# CORS
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Database (shared with Node.js backend)
DATABASE_URL=postgresql://postgres:password@localhost:5432/myjudicial

# Ollama/LLM
LLM_PROVIDER=ollama  # Options: ollama (local/VPS) or groq (cloud API)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest
OLLAMA_TIMEOUT=60

# Groq API (Alternative to Ollama - Free & Fast!)
# Get your free API key from: https://console.groq.com
GROQ_API_KEY=  # Optional: gsk_...
GROQ_MODEL=llama3-8b-8192  # Options: llama3-8b-8192, mixtral-8x7b-32768, gemma-7b-it

# Whisper
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Caching
CACHE_EMBEDDINGS=true
CACHE_SIZE=1000
