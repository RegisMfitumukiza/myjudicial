NODE_ENV=development
PORT=4000

# =============================================
# DATABASE (Supabase PostgreSQL)
# Get from: Supabase Dashboard → Settings → Database → Connection string
# =============================================
# Transaction pooler — used by the running app (port 6543)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection — used for migrations only (port 5432)
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# =============================================
# SUPABASE AUTH
# Get from: Supabase Dashboard → Settings → API
# =============================================
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# =============================================
# LOCATION SERVICES (FREE - OpenStreetMap/Nominatim)
# No API key required - uses OpenStreetMap Nominatim
# =============================================
# GOOGLE_PLACES_API_KEY=AIza... (Optional - only if you want to upgrade later)

# Webhook secret for Supabase Auth events (user create/update/delete)
# Generate a secure random string (e.g., openssl rand -hex 32)
# Configure in Supabase Dashboard → Database → Webhooks
SUPABASE_WEBHOOK_SECRET=

# =============================================
# REDIS
# Free tier: https://upstash.com → Create Redis DB → copy rediss:// URL
# =============================================
REDIS_URL=rediss://default:[password]@[host].upstash.io:6379

# =============================================
# EMAIL (Brevo)
# Get API key from: https://app.brevo.com/settings/keys/api
# =============================================
BREVO_API_KEY=xkeysib-...
EMAIL_FROM_NAME=MyJudicial
EMAIL_FROM_ADDRESS=your-verified-sender@example.com
# Real logo used in email header. Defaults to ${FRONTEND_URL}/myjudicial-logo-white.png
EMAIL_LOGO_URL=https://myjudicial.com/myjudicial-logo-white.png

# =============================================
# FRONTEND
# =============================================
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# =============================================
# AZAM PAY (Mobile Money payments / escrow)
# Get credentials from the Azam Pay merchant dashboard.
# Required for POST /bookings to initiate a Mobile Money (MNO) checkout,
# and for expert payouts and refunds via AzamPayService.
# =============================================
AZAMPAY_APP_NAME=
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
# X-API-KEY — required for sandbox, optional for production. Get from AzamPay dashboard.
# "sandbox" (default) or "production" — selects which Azam Pay hosts are called.
# Sandbox and production credentials are issued separately; using the wrong
# AZAMPAY_ENV for a given credential set will be rejected by Azam Pay.
AZAMPAY_ENV=sandbox
# Shared secret for verifying POST /payments/webhook and /payments/payout-webhook.
# Required in the x-azampay-signature header as HMAC-SHA256(rawBody, this secret).
# Requests without a valid signature are rejected with 401. This is MyJudicial's
# own verification scheme — confirm Azam Pay's actual webhook signing mechanism
# against their dashboard/docs before going live, and adjust if needed.
AZAMPAY_DISBURSEMENT_ENABLED=false
# Public base URL of this API (used to build the Azam Pay redirect/callback
# URLs) — e.g. https://api.myjudicial.com in production.
BASE_URL=http://localhost:4000

# =============================================
# ADMIN SEED
# Used only by: npm run db:seed
# =============================================
ADMIN_EMAIL=admin@myjudicial.com
ADMIN_FULL_NAME=MyJudicial Admin
ADMIN_PASSWORD=         # Strong password — min 8 chars, used for POST /auth/admin/login

# =============================================
# AI SERVICE (Python Microservice)
# The AI service runs on port 5000 and handles:
# - Case analysis (Ollama/Qwen)
# - Voice transcription (Whisper)
# - Translation (LLM)
# - Semantic search (pgvector embeddings)
# - Expert recommendations (ranking engine)
# =============================================
AI_SERVICE_URL=http://localhost:5000
AI_SERVICE_KEY=dev-secret-key-12323456

# =============================================
# LOGGING
# =============================================
LOG_LEVEL=info

# =============================================
# LIVEKIT (Video Consultations)
#
# Setup Instructions:
#   1. Create account at https://livekit.io
#   2. Create a project
#   3. Get API Key and Secret from Dashboard → Settings → Keys
#   4. Copy WebSocket URL (wss://your-project.livekit.cloud)
#
# Already implemented and integrated with booking system
# =============================================
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_HOST=https://your-project.livekit.cloud

# =============================================
# PLATFORM SETTINGS
# =============================================
# Commission rate (0.15 = 15%)
PLATFORM_COMMISSION=0.15

# =============================================
# OCI OBJECT STORAGE (S3-Compatible API)
#
# Setup:
#   1. OCI Console → Storage → Buckets → Create Bucket (name: myjudicial-vault)
#   2. OCI Console → Identity → Users → your user → Customer Secret Keys → Generate
#   3. OCI Console → Storage → Buckets → myjudicial-vault → copy Namespace from bucket details
#
# Endpoint format:
#   https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
#
# Example region codes: us-ashburn-1, eu-frankfurt-1, ap-singapore-1
# =============================================
OCI_ENDPOINT=https://[namespace].compat.objectstorage.[region].oraclecloud.com
OCI_BUCKET_NAME=myjudicial-vault
OCI_REGION=us-ashburn-1
OCI_ACCESS_KEY_ID=                  # Customer Secret Key access key (from OCI Console)
OCI_SECRET_ACCESS_KEY=              # Customer Secret Key secret (from OCI Console)
OCI_KMS_ENDPOINT=                   # e.g., https://[id]-crypto.kms.[region].oci.oraclecloud.com
OCI_KMS_MASTER_KEY_ID=              # OCID of the Master Encryption Key in Vault
# Signed URL TTL in seconds — default 900 (15 minutes). Max recommended: 3600 (1 hour).
OCI_SIGNED_URL_EXPIRY_SECONDS=900


# =============================================
# DATABASE POOL TUNING (Optional — sensible defaults applied automatically)
# =============================================
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=15000
DB_STATEMENT_TIMEOUT_MS=30000
DB_CONNECTION_MAX_USES=7500

# =============================================
# RWANDA SMS GATEWAY (Optional — Multi-Provider Support)
# Configure ANY ONE provider below to enable SMS OTPs & consultation reminders.
# Supported providers: "pindo", "africastalking", "twilio", or "webhook"
# =============================================
SMS_PROVIDER=                       # Optional explicit override: pindo | africastalking | twilio | webhook
# Option A: Pindo (Rwanda Tier-1 SMS Gateway — https://pindo.io)
PINDO_API_TOKEN=
PINDO_SENDER_ID=MyJudicial

# Option B: Africa's Talking Rwanda (https://africastalking.com)
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=MyJudicial

# Option C: Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Option D: Custom MNO HTTP Webhook
SMS_WEBHOOK_URL=
SMS_WEBHOOK_SECRET=

# =============================================
# MALWARE & PAYLOAD SCANNING (Optional — Layer 1 byte/signature scanner is always active)
# =============================================
# Layer 2: ClamAV clamd TCP daemon (e.g. Docker container clamav/clamav:stable)
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=8000
# Layer 3: External Cloud AV Webhook
MALWARE_SCAN_WEBHOOK_URL=
MALWARE_SCAN_WEBHOOK_SECRET=
# Set to "true" to reject uploads if external ClamAV/Webhook is unreachable
MALWARE_SCAN_FAIL_CLOSED=false
