generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  engine              = "client"
  previewFeatures     = ["postgresqlExtensions", "partialIndexes"]
  // Pin output shape - auto-detection differs between local (tsconfig.json
  // present) and Docker builder (only package.json + prisma/ copied when
  // `prisma generate` runs), which made CI emit ".ts" import specifiers that
  // break at runtime after tsc compilation.
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis, pg_stat_statements, pgcrypto, supabase_vault, uuid_ossp(map: "uuid-ossp")]
}

enum Role {
  CITIZEN
  EXPERT
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DELETED
}

enum ExpertStatus {
  DRAFT
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  SUSPENDED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum LegalSpecialty {
  FAMILY_LAW
  COMMERCIAL_LAW
  EMPLOYMENT_LAW
  LAND_LAW
  CRIMINAL_LAW
  TAX_LAW
  IMMIGRATION_LAW
  CORPORATE_LAW
  CONTRACT_LAW
  INTELLECTUAL_PROPERTY
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  VERIFY
  REJECT
  BOOK
  CANCEL
  PAYMENT
  ESCROW_LOCKED
  ESCROW_RELEASED
  UPLOAD
  READ
  DOWNLOAD
  SHARE
}

enum AuditResource {
  USER
  EXPERT
  BOOKING
  SERVICE
  REVIEW
  VERIFICATION
  PAYMENT
  DOCUMENT
  CONVERSATION
  MESSAGE
  CONTENT_PAGE
}

enum OAuthProvider {
  LINKEDIN
  GOOGLE
}

model User {
  id                String     @id @default(uuid())
  email             String     @unique
  passwordHash      String?
  firstName         String
  lastName          String
  phone             String?    @unique
  role              Role
  status            UserStatus @default(PENDING)
  avatarObjectKey   String?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  preferredLanguage String     @default("en")
  onboarding        Json?

  expertProfile            ExpertProfile?
  citizenBookings          Booking[]                 @relation("CitizenBookings")
  reviews                  Review[]
  reviewReports            ReviewReport[]
  reviewReactions          ReviewReaction[]
  auditLogs                AuditLog[]                @relation("ActorAuditLogs")
  oauthAccounts            OAuthAccount[]
  refreshTokens            RefreshToken[]
  passwordResetTokens      PasswordResetToken[]
  verificationReviews      ExpertVerification[]      @relation("VerificationReviews")
  triageSessions           TriageSession[]
  ownedDocuments           Document[]                @relation("OwnedDocuments")
  uploadedDocuments        Document[]                @relation("UploadedDocuments")
  sharedDocuments          DocumentShare[]           @relation("SharedDocuments")
  notificationLogs         NotificationLog[]
  notificationPreference   NotificationPreference?
  adminActions             AdminAction[]             @relation("AdminUser")
  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]                 @relation("SentMessages")
  savedExperts             SavedExpert[]             @relation("SavedExperts")
  contentPageRevisions     ContentPageRevision[]
  legalConsents            UserLegalConsent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model OAuthAccount {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider       OAuthProvider
  providerUserId String
  providerEmail  String?

  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash  String    @unique
  expiresAt  DateTime
  rememberMe Boolean   @default(false)
  revokedAt  DateTime?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model ExpertProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName           String
  bio                   String?
  firmName              String?
  profileImageObjectKey String?
  profileImageUpdatedAt DateTime?
  firmLogoObjectKey     String?
  barNumber             String?
  yearsExperience       Int?
  status                ExpertStatus @default(DRAFT)

  primarySpecialty LegalSpecialty
  specialties      LegalSpecialty[]
  languages        String[]

  officeAddress String?
  city          String?
  country       String   @default("Rwanda")
  latitude      Decimal? @db.Decimal(9, 6)
  longitude     Decimal? @db.Decimal(9, 6)

  baseConsultationFee Decimal? @db.Decimal(12, 2)
  currency            String   @default("RWF")

  // Compliance
  credentialsExpiry   DateTime?
  lastComplianceCheck DateTime?

  services              LegalService[]
  bookings              Booking[]               @relation("ExpertBookings")
  verifications         ExpertVerification[]
  reviews               Review[]
  expertReplies         ExpertReply[]
  adminActions          AdminAction[]           @relation("ExpertActions")
  availability          ExpertAvailability[]
  availabilityOverrides AvailabilityOverride[]
  scheduleSettings      ExpertScheduleSettings?
  education             ExpertEducation[]
  certifications        ExpertCertification[]
  momoNumber            String?
  mapMarker             MapMarker?
  referralCode          ReferralCode?
  quotations            Quotation[]
  savedByUsers          SavedExpert[]            @relation("SavedByUsers")

  // Denormalized for fast map-search queries (updated on each review submission)
  averageRating Decimal? @db.Decimal(3, 2)
  reviewCount   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([city])
  @@index([primarySpecialty])
  @@index([credentialsExpiry])
  @@map("experts")
}

model LegalService {
  id       String        @id @default(uuid())
  expertId String
  expert   ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)

  name         String
  description  String?
  category     String? // e.g. "consultation", "document_review", "court_representation", "contract_drafting", "legal_advice", "other"
  deliveryMode String  @default("VIDEO") // VIDEO, PHONE, IN_PERSON, EMAIL
  durationMin  Int
  flatFee      Decimal @db.Decimal(12, 2)
  currency     String  @default("RWF")
  isActive     Boolean @default(true)
  isDefault    Boolean @default(false)
  sortOrder    Int     @default(0)

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expertId])
  @@index([category])
  @@index([isActive, isDefault])
  @@map("services")
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

model Quotation {
  id       String        @id @default(uuid())
  expertId String
  expert   ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)

  clientName  String
  clientEmail String?
  clientPhone String?

  title       String
  description String?
  amount      Decimal         @db.Decimal(12, 2)
  currency    String          @default("RWF")
  status      QuotationStatus @default(DRAFT)
  validUntil  DateTime?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expertId])
  @@index([status])
  @@map("quotations")
}

model Booking {
  id String @id @default(uuid())

  citizenId String
  citizen   User   @relation("CitizenBookings", fields: [citizenId], references: [id])

  expertId String
  expert   ExpertProfile @relation("ExpertBookings", fields: [expertId], references: [id])

  serviceId String
  service   LegalService @relation(fields: [serviceId], references: [id])

  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  scheduledStart DateTime
  scheduledEnd   DateTime

  meetingRoomId  String?
  meetingJoinUrl String?

  paymentReferenceId String?
  citizenNotes       String?

  escrowLockedAt   DateTime?
  escrowReleasedAt DateTime?
  platformFee      Decimal?  @db.Decimal(12, 2)
  expertPayout     Decimal?  @db.Decimal(12, 2)

   cancellationReason String?
   completedAt        DateTime?

   pendingRescheduleStart      DateTime?
   pendingRescheduleEnd        DateTime?
   pendingRescheduleReason     String?
   pendingRescheduleRequestedBy String?

   review       Review?
  documents    Document[]
  payment      Payment?
  escrowLedger EscrowLedger?
  conversation Conversation?

  reminderSent      Boolean   @default(false)
  actualStartTime   DateTime?
  actualEndTime     DateTime?
  actualDurationMin Int?

  deliveredAt                  DateTime?
  deliverySummary              String?
  autoReleaseAt                DateTime?
  issueReportedAt              DateTime?
  issueReason                  String?

  hasRecording                 Boolean   @default(false)
  recordingObjectKey           String?
  recordingDurationSec         Int?
  recordingStartedAt           DateTime?
  recordingEndedAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([expertId, scheduledStart], name: "unique_active_booking_per_expert_slot", where: raw("status <> ALL (ARRAY['CANCELLED'::\"BookingStatus\", 'REFUNDED'::\"BookingStatus\"])"))
  @@index([citizenId])
  @@index([expertId])
  @@index([serviceId])
  @@index([status])
  @@index([scheduledStart])
  @@index([autoReleaseAt])
  @@map("bookings")
}

model Payment {
  id        String  @id @default(uuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id])

  amount       Decimal @db.Decimal(12, 2)
  currency     String  @default("RWF")
  platformFee  Decimal @db.Decimal(12, 2)
  expertPayout Decimal @db.Decimal(12, 2)

  txRef                 String  @unique
  providerTransactionId String?
  providerPayoutRef     String?

  status PaymentStatus @default(PENDING)

  paidAt       DateTime?
  payoutSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([status])
  @@index([txRef])
  @@map("payments")
}

model ExpertVerification {
  id       String        @id @default(uuid())
  expertId String
  expert   ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)

  status VerificationStatus @default(PENDING)

  identityDocumentObjectKey String?
  barCertificateObjectKey   String?
  additionalDocumentKeys    String[]
  rejectionReason           String?

  reviewedById String?
  reviewedBy   User?     @relation("VerificationReviews", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expertId])
  @@index([status])
  @@map("expert_verifications")
}

model Review {
  id String @id @default(uuid())

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  citizenId String
  citizen   User   @relation(fields: [citizenId], references: [id])

  expertId String
  expert   ExpertProfile @relation(fields: [expertId], references: [id])

  rating  Int
  title   String?
  comment String?

  // Status and moderation
  status           ReviewStatus @default(PUBLISHED)
  moderatedBy      String?
  moderatedAt      DateTime?
  moderationReason String?

  // Engagement metrics
  helpfulCount   Int @default(0)
  unhelpfulCount Int @default(0)

  // Soft delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  editedAt  DateTime?

  // Relations
  reports     ReviewReport[]
  reactions   ReviewReaction[]
  expertReply ExpertReply?

  @@index([expertId])
  @@index([citizenId])
  @@index([status])
  @@index([isDeleted])
  @@map("reviews")
}

model ReviewReport {
  id String @id @default(uuid())

  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  reportedBy String
  reporter   User   @relation(fields: [reportedBy], references: [id])

  reason  ReviewReportReason
  details String?

  // Moderation
  resolved   Boolean   @default(false)
  resolvedBy String?
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  @@index([reviewId])
  @@index([reportedBy])
  @@index([resolved])
  @@map("review_reports")
}

model ReviewReaction {
  id String @id @default(uuid())

  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  isHelpful Boolean // true = helpful, false = unhelpful

  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@index([userId])
  @@map("review_reactions")
}

model ExpertReply {
  id String @id @default(uuid())

  reviewId String @unique
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  expertId String
  expert   ExpertProfile @relation(fields: [expertId], references: [id])

  reply String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  editedAt  DateTime?

  @@index([expertId])
  @@map("expert_replies")
}

model AuditLog {
  id String @id @default(uuid())

  actorId String?
  actor   User?   @relation("ActorAuditLogs", fields: [actorId], references: [id])

  action     AuditAction
  resource   AuditResource
  resourceId String?

  description String?
  metadata    Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([resource])
  @@index([resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum PresenceStatus {
  ONLINE
  OFFLINE
  BUSY
  ON_LEAVE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum OverrideType {
  CLOSED
  CUSTOM_HOURS
  REDUCED_CAPACITY
}

enum DocumentAccess {
  PRIVATE
  SHARED
  PUBLIC
}

enum NotificationEvent {
  OTP_SENT
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_REMINDER
  PAYMENT_SUCCESS
  ESCROW_RELEASED
  CREDENTIAL_EXPIRY_WARNING
  REVIEW_RECEIVED
  WELCOME
  MAGIC_LINK_SENT
  REFUND_PROCESSED
  MESSAGE_RECEIVED
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
}

model ExpertAvailability {
  id       String        @id @default(uuid())
  expertId String
  expert   ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)

  presenceStatus PresenceStatus @default(OFFLINE)

  // Weekly schedule slots
  dayOfWeek DayOfWeek

  // Legacy single time block (Phase 1-3 compatibility)
  startTime String // HH:MM format e.g. "09:00"
  endTime   String // HH:MM format e.g. "17:00"

  // Phase 4: Multiple time blocks per day
  // Format: [{"start": "09:00", "end": "12:00"}, {"start": "14:00", "end": "17:00"}]
  timeBlocks Json? @map("time_blocks")

  // Flag to indicate which format is active
  usesTimeBlocks Boolean @default(false) @map("uses_time_blocks")

  isAvailable Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([expertId, dayOfWeek])
  @@index([expertId])
  @@map("expert_availability")
}

model ExpertScheduleSettings {
  id       String        @id @default(uuid())
  expertId String        @unique
  expert   ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)

  // Timezone for scheduling (IANA timezone identifier)
  timezone String @default("Africa/Kigali")

  // Buffer time between appointments (minutes)
  bufferTimeMinutes Int @default(15)

  // Minimum advance notice required for bookings (hours)
  advanceNoticeHours Int @default(24)

  // Maximum days in advance clients can book
  maxDaysInAdvance Int @default(60)

  // Maximum bookings allowed per day (null = unlimited)
  maxBookingsPerDay Int?

  // Whether presence status (ONLINE/OFFLINE) blocks bookings
  respectPresenceStatus Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("expert_schedule_settings")
}

model AvailabilityOverride {
  id       String        @id @default(uuid())
  expertId String
  expert   ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)

  // Date this override applies to (in expert's timezone)
  date DateTime @db.Date

  // Type of override
  overrideType OverrideType

  // For CUSTOM_HOURS: custom start/end times
  startTime String? // HH:MM format
  endTime   String? // HH:MM format

  // For REDUCED_CAPACITY: maximum bookings
  maxBookings Int?

  // Optional reason/note
  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([expertId, date])
  @@index([expertId])
  @@index([date])
  @@index([expertId, date])
  @@map("availability_overrides")
}

model ExpertEducation {
  id       String        @id @default(uuid())
  expertId String
  expert   ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)

  institution   String
  degree        String
  fieldOfStudy  String?
  yearCompleted Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expertId])
  @@map("expert_education")
}

model ExpertCertification {
  id       String        @id @default(uuid())
  expertId String
  expert   ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)

  certificateName   String
  issuer            String
  issueDate         DateTime
  expiryDate        DateTime?
  documentObjectKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expertId])
  @@index([expiryDate])
  @@map("expert_certifications")
}

enum EscrowStatus {
  PENDING
  LOCKED
  HELD_IN_ESCROW
  DISBURSED_TO_EXPERT
  REFUNDED
}

enum TriageStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
  FLAGGED
  REMOVED
}

enum ReviewReportReason {
  SPAM
  HARASSMENT
  OFFENSIVE_LANGUAGE
  FAKE_REVIEW
  OTHER
}

// ─── Chat Enums ──────────────────────────────────────────────────────────────

enum ConversationType {
  CONSULTATION
  SUPPORT
  GROUP
  SYSTEM
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  CLOSED
}

enum ParticipantRole {
  MEMBER
  MODERATOR
  ADMIN
}

enum MessageType {
  TEXT
  EMOJI
  IMAGE
  PDF
  DOCUMENT
  SYSTEM
}

enum MessageStatus {
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model MapMarker {
  id       String        @id @default(uuid())
  expertId String        @unique
  expert   ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)

  latitude  Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)

  // PostGIS Point type for ST_DWithin geospatial radius queries
  location Unsupported("geography(Point, 4326)")

  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([location], type: Gist)
  @@map("map_markers")
}

model EscrowLedger {
  id                String       @id @default(uuid())
  roomId            String       @unique
  bookingId         String       @unique
  booking           Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  lawyerWalletPhone String?
  totalFee          Decimal      @db.Decimal(12, 2)
  currency          String       @default("RWF")
  status            EscrowStatus @default(PENDING)
  createdAt         DateTime     @default(now())
  settledAt         DateTime?

  @@map("escrow_ledger")
}

model TriageSession {
  id                    String          @id @default(uuid())
  clientId              String?
  client                User?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  status                TriageStatus    @default(IN_PROGRESS)
  conversation          Json // Array of {role, content, timestamp}
  summary               String?         @db.Text
  extractedJurisdiction String?
  extractedSpecialty    LegalSpecialty?
  extractedUrgency      UrgencyLevel?
  extractedBudgetMin    Decimal?        @db.Decimal(12, 2)
  extractedBudgetMax    Decimal?        @db.Decimal(12, 2)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([clientId])
  @@map("triage_sessions")
}

// ─── File Sensitivity & Owner Type ───────────────────────────────────────────

enum FileSensitivity {
  PUBLIC // profile photos, public lawyer images
  PRIVATE // uploaded documents
  CONFIDENTIAL // legal evidence, national IDs, practicing certificates, court filings
}

enum FileOwnerType {
  USER
  EXPERT
  CASE
  COMPLIANCE
}

// ─────────────────────────────────────────────────────────────────────────────

model Document {
  id String @id @default(uuid())

  // Polymorphic ownership — ownerId references users.id or experts.id
  // depending on ownerType. FK enforcement is handled at the service layer.
  ownerId   String
  owner     User          @relation("OwnedDocuments", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerType FileOwnerType @default(USER)

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id])

  // OCI Object Storage location
  bucketName String @default("")
  objectKey  String @unique

  // File metadata
  fileName String
  mimeType String
  fileSize Int
  category String? // e.g. "expert-certificate", "expert-national-id", "case-evidence", "chat-attachment", etc.

  // Sensitivity classification
  sensitivity FileSensitivity @default(PRIVATE)

  // Client-side encryption metadata (AES-256-GCM)
  // encryptedAesKey & iv remain for backward compat with early vault records.
  // encryptionAlgorithm / keyVersion / encryptedAt support future KMS integration.
  encryptedAesKey     String?
  iv                  String?
  encryptionAlgorithm String?   @default("AES-256-GCM")
  keyVersion          String? // e.g. "v1", "kms-oci-vault-key-1"
  kmsKeyId            String? // The Master Key ID used to wrap the DEK
  encryptedAt         DateTime? // when the client performed encryption

  isVault   Boolean   @default(true)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  uploadedById String?
  uploadedBy   User?   @relation("UploadedDocuments", fields: [uploadedById], references: [id], onDelete: SetNull)

  shares    DocumentShare[]
  auditLogs DocumentAudit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([ownerType])
  @@index([sensitivity])
  @@index([category])
  @@index([bookingId])
  @@index([uploadedById])
  @@index([isDeleted])
  @@map("documents")
}

// DOCUMENT SHARE

model DocumentShare {
  id           String    @id @default(uuid())
  documentId   String
  document     Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sharedWithId String
  sharedWith   User      @relation("SharedDocuments", fields: [sharedWithId], references: [id], onDelete: Cascade)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  @@unique([documentId, sharedWithId])
  @@index([sharedWithId])
  @@map("document_shares")
}

// DOCUMENT AUDIT

model DocumentAudit {
  id         String   @id @default(uuid())
  documentId String   @map("document_id")
  actorId    String   @map("actor_id")
  action     String // "upload"|"view"|"download"|"share"|"delete"
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_audits")
}

// NOTIFICATION LOG

model NotificationPreference {
  id       String  @id @default(uuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email    Boolean @default(true)
  push     Boolean @default(true)
  inApp    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_preferences")
}

model NotificationLog {
  id        String              @id @default(uuid())
  userId    String              @map("user_id")
  event     NotificationEvent
  channel   NotificationChannel @default(EMAIL)
  recipient String
  subject   String?
  body      String?
  sent      Boolean             @default(false)
  sentAt    DateTime?           @map("sent_at")
  readAt    DateTime?           @map("read_at")
  errorMsg  String?             @map("error_msg")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([channel])
  @@index([event])
  @@index([userId, readAt])
  @@map("notification_logs")
}

// ADMIN ACTION  (audit trail)

model AdminAction {
  id          String   @id @default(uuid())
  adminUserId String   @map("admin_user_id")
  expertId    String?  @map("expert_id")
  action      String
  reason      String?
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  adminUser User           @relation("AdminUser", fields: [adminUserId], references: [id])
  expert    ExpertProfile? @relation("ExpertActions", fields: [expertId], references: [id])

  @@map("admin_actions")
}

model ReferralCode {
  id        String        @id @default(uuid())
  expertId  String        @unique
  expert    ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)
  code      String        @unique
  signups   Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("referral_codes")
}

// ─── Chat System ─────────────────────────────────────────────────────────────

model Conversation {
  id        String  @id @default(uuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  type   ConversationType   @default(CONSULTATION)
  status ConversationStatus @default(ACTIVE)

  lastMessageAt   DateTime?
  lastMessageText String?   @db.Text

  // Metadata
  isArchived Boolean   @default(false)
  archivedAt DateTime?

  // Relations
  participants ConversationParticipant[]
  messages     Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([status])
  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role ParticipantRole @default(MEMBER)

  // Read tracking
  lastReadAt        DateTime?
  lastReadMessageId String?

  // Joined/left tracking
  joinedAt DateTime  @default(now())
  leftAt   DateTime?
  isActive Boolean   @default(true)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("SentMessages", fields: [senderId], references: [id])

  messageType MessageType @default(TEXT)
  content     String?     @db.Text

  // Attachments (array of Document.id references)
  attachmentIds String[]

  // Status tracking
  status      MessageStatus @default(SENT)
  deliveredAt DateTime?

  // Edit/Delete tracking
  isEdited  Boolean   @default(false)
  editedAt  DateTime?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  // Future: Reply threading
  replyToId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@index([isDeleted])
  @@index([messageType])
  @@map("messages")
}

// ─── Platform Settings ─────────────────────────────────────────────────────────

model PlatformSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("platform_settings")
}

// ─── Saved Experts ──────────────────────────────────────────────────────────

model SavedExpert {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  expertId    String   @map("expert_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user   User          @relation("SavedExperts", fields: [userId], references: [id], onDelete: Cascade)
  expert ExpertProfile @relation("SavedByUsers", fields: [expertId], references: [id], onDelete: Cascade)

  @@unique([userId, expertId])
  @@index([userId])
  @@index([expertId])
  @@map("saved_experts")
}

// ─── Email Logs ────────────────────────────────────────────────────────────────

model EmailLog {
  id       String         @id @default(cuid())
  toEmail  String         @map("to_email")
  subject  String?
  template String?
  status   EmailLogStatus @default(SENT)
  error    String?
  sentAt   DateTime       @default(now()) @map("sent_at")

  @@index([sentAt])
  @@index([status])
  @@map("email_logs")
}

enum EmailLogStatus {
  SENT
  FAILED
}

// ─── Editable public content pages (admin-authored, per locale) ──────────────
// Body copy lives here as an ordered array of typed blocks rather than as
// hardcoded message strings, so an admin can publish real, reviewed text and a
// page that has never been written stays in `draft` instead of rendering
// invented legal or policy content.

enum ContentPageSlug {
  ABOUT
  CAREERS
  HELP
  CONTACT
  PRIVACY
  TERMS
  COOKIES
}

enum ContentPageStatus {
  draft
  published
}

model ContentPage {
  id            String            @id @default(uuid()) @db.Uuid
  slug          ContentPageSlug
  locale        String
  title         String
  blocks        Json
  status        ContentPageStatus @default(draft)
  version       String            @default("1.0") @map("version")
  effectiveDate String?           @map("effective_date")
  metaTitle     String?           @map("meta_title")
  metaDescription String?         @map("meta_description")
  openGraphImage String?          @map("og_image")
  updatedBy     String?           @map("updated_by")
  revisions     ContentPageRevision[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([slug, locale])
  @@index([slug, status])
  @@index([locale])
  @@map("content_pages")
}

/** Snapshot of a content page at the moment of a save, publish, copy, or restore. */
model ContentPageRevision {
  id              String            @id @default(uuid()) @db.Uuid
  pageId          String            @map("page_id") @db.Uuid
  page            ContentPage       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  title           String
  blocks          Json
  status          ContentPageStatus
  version         String            @default("1.0") @map("version")
  effectiveDate   String?           @map("effective_date")
  metaTitle       String?           @map("meta_title")
  metaDescription String?           @map("meta_description")
  openGraphImage  String?           @map("og_image")
  authorId        String?           @map("author_id")
  author          User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  changeType      String            @default("SAVE") @map("change_type")
  createdAt       DateTime          @default(now()) @map("created_at")

  @@index([pageId, createdAt(sort: Desc)])
  @@map("content_page_revisions")
}

enum LegalDocumentType {
  TERMS
  PRIVACY
  COOKIES
  ADVOCATE_AGREEMENT
}

enum ConsentContext {
  REGISTRATION
  BOOKING_CHECKOUT
  PORTAL_REACCEPTANCE
  VOLUNTARY_UPDATE
}

model UserLegalConsent {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @map("user_id")
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentType LegalDocumentType @map("document_type")
  version      String
  acceptedAt   DateTime          @default(now()) @map("accepted_at")
  locale       String            @default("en")
  ipAddress    String?           @map("ip_address")
  userAgent    String?           @map("user_agent")
  context      ConsentContext    @default(REGISTRATION)

  createdAt    DateTime          @default(now()) @map("created_at")

  @@index([userId, documentType])
  @@index([documentType, version])
  @@map("user_legal_consents")
}

model Specialty {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  label       String
  description String?
  icon        String?
  group       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("specialties")
}
