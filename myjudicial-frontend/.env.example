NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_API_PREFIX="/api/v1"
NEXT_PUBLIC_ADMIN_PORTAL_HOST="admin.myjudicial.com"
AUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-generated-secret"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/myjudicial?schema=public"
LOG_LEVEL="debug"
RATE_LIMIT_ENABLED="true"
REDIS_URL="redis://localhost:6379"
# Chat realtime — same project as the backend's SUPABASE_URL/SUPABASE_ANON_KEY.
# The anon key is safe to expose client-side; access is enforced by RLS
# (see backend/prisma/migrations/manual_enable_chat_realtime_rls.sql).
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-me"

# LiveKit — WebSocket URL for video consultations
NEXT_PUBLIC_LIVEKIT_URL="wss://your-project.livekit.cloud"

LIVEKIT_URL="http://127.0.0.1:7880"
LIVEKIT_API_KEY="replace-me"
LIVEKIT_API_SECRET="replace-me"

# Optional SMS provider for future booking notifications.
SMS_PROVIDER="console"
SMS_FROM="MyJudicial"

# Transactional email for email OTP auth, magic links, password recovery, and notifications.
EMAIL_PROVIDER="console" # console | ses
EMAIL_FROM="MyJudicial <no-reply@myjudicial.com>"
EMAIL_REPLY_TO="support@myjudicial.com"
AWS_REGION="replace-me"
AWS_SES_REGION=""
AWS_SES_CONFIGURATION_SET=""
AWS_ACCESS_KEY_ID="replace-me"
AWS_SECRET_ACCESS_KEY="replace-me"

# Admin seed
ADMIN_EMAIL="admin@myjudicial.local"
ADMIN_FULL_NAME="MyJudicial Admin"
ADMIN_PASSWORD="ChangeThisAdminPassword123"
ADMIN_RESET_PASSWORD="false"
